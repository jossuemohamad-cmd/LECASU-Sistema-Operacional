# ============================================================
# LECASU ERP - Variaveis de Ambiente
# Copie este ficheiro para .env e preencha com os valores reais
# NUNCA envie o ficheiro .env para o GitHub!
# ============================================================

PROJECT_NAME=LECASU Sistema Operacional

# Base de Dados (PostgreSQL / Neon)
DATABASE_URL=postgresql://usuario:password@host/database?sslmode=require

# JWT (chave secreta para tokens de sessao - use uma string longa e aleatoria)
SECRET_KEY=coloque-aqui-uma-chave-secreta-muito-longa-e-aleatoria

# Neon S3 Object Storage
AWS_ENDPOINT_URL_S3=https://seu-endpoint.storage.neon.tech
AWS_ACCESS_KEY_ID=sua-access-key-id
AWS_SECRET_ACCESS_KEY=sua-secret-access-key
AWS_REGION=us-east-2
S3_BUCKET_NAME=assets

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_PROJECT_ID=seu-project-id
